# Copy to .env and fill in values. Loaded at startup by internal/envfile.
# Real environment variables always take priority over values in this file.

# Shared bearer token MCP clients (Miranda) present to call this service's
# tools. Must match the name given by auth_token_env in config/config.yaml.
# Generate with: openssl rand -hex 32
MIRANDA_TTS_MCP_TOKEN=

# Gemini API keys, one per env var; the names are listed in
# gemini_api_key_envs. More keys = more quota to rotate across.
GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=

# Home Assistant REST access, used only by the MCP speak/stop tools (the
# Wyoming server does not need it). Long-lived access token.
HA_BASE_URL=http://192.168.1.50:8123
HA_TOKEN=
